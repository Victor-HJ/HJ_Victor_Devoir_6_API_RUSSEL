<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" name="API_Russel" content="Page de connexion de l'API">
    <title> API Russel </title>
    <link rel="stylesheet" href="/stylesheets/style_index.css">
</head>

<header>
    <div id="title-API"> 
        <h1> Bienvenue sur l'API du port de plaisance Russell </h1>
    </div>

</header>

<main>
    <section id="connect-section">
        <h2 class="connect-title"> Connexion </h2>

        <div>
            <form id="login_form">
                <div class="form-div">
                    <input type="text" name="email" id="email" placeholder="Votre email">
                </div>

                <div class="form-div">
                    <input type="password" name="password" id="password" placeholder="Votre mot de passe">
                </div>
                <div id="connect-btn-div">
                    <button type="submit">Se connecter</button>
                </div>
            </form>
        </div>

        <div id="doc-btn-div">
                    <a href="./docs"> La documentation </a>
        </div>

    <div id="error" style="color : red; font-weight: 700;"></div>
    </section>
    <section id="photo-section">
        <img src="/images/marina-photo.png" alt="Photo du port de plaisance" id="illustration">
    </section>
</main>


<script>

    const form = document.getElementById('login_form');
    const error = document.getElementById('error');

    form.addEventListener('submit', async(e) => {

        e.preventDefault();

        const email = document.getElementById('email').value;
        const password = document.getElementById('password').value;

        try {

            const response = await fetch('/authentication/login', {

                method : 'POST',
                headers : {
                    'Content-Type' : 'application/json'
                },
                body : JSON.stringify({email, password})
                
            });

            if(response.ok) {

                window.location.href = '/dashboard_view'

            } else {

                error.textContent = await response.text();

            }

        } catch (error) {
            
            error.textContent = await response.text();

        }
    });
</script>