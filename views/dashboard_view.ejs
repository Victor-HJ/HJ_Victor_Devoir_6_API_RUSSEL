<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" name="Dashboard" content="Tableau de bord de l'API">
    <title>Dashboard</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>
    <header>
        <div>
            <h1 class="main-title"> Tableau de bord </h1>

            <div id="dashboard-user-props">
                    <p class="connected-user"><%= user?.username%></p>
                    <p> || </p>
                    <p class="connected-user"><%= user?.email%></p>
                    <p> || </p>
                    <p id="current-date"><%= currentDate %></p>
            </div>
        </div>

        <nav class="nav-menu">
            <a class="nav-button" href="/catways_view"> Catways </a>
            <a class="nav-button" href="/users_view"> Utilisateurs </a>
            <a class="nav-button" href="/reservations_view"> Réservations </a>
            <a class="nav-button" href="/docs"> Documentation </a>
            <a class="nav-button" href="/"> Déconnexion </a>
        </nav>
    </header>

    <main>
        <h2 class="little-titles"> Liste des réservations en cours </h2>

        <div id="no-current-reservations"></div>

        <table class="get-table" id="current-reservations">
            <thead>
                <tr>
                    <th> Numéro de Catway </th>
                    <th> Nom du client </th>
                    <th> Nom du bateau </th>
                    <th> Date de début </th>
                    <th> Date de fin </th>
                </tr>
            </thead>

            <tbody id="current-reservations-table-body"></tbody>
        </table>
    </main>

    <script src="/scripts/utils.js"></script>
    <script src="/scripts/dashboard_script.js"></script>
</body>
</html>

