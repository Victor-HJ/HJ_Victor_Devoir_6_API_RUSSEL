<div id="title_div"> 
    <h1> Bienvenue </h1>
</div>

<div id="presentation_div">
     <p> T'es sur l'API du port de plaisance Russel mon salaud, connecte toi pour faire des trucs </p>
</div>

<div>
    <h2> Connexion </h2>

    <div>
        <form id="login_form">
            <div>
                <label for="email">Email</label>
                <input type="text" id="email">
            </div>

            <div>
                <label for="password">Mot de passe</label>
                <input type="text" id="password">
            </div>

            <button type="submit">Se connecter</button>
        </form>
    </div>

    <div id="error" style="color : red; font-weight: 700;"></div>
</div>

<div>
    <a href="./docs"> La doc </a>
</div>

<script>

    const form = document.getElementById('login_form');
    const error = document.getElementById('error');

    form.addEventListener('submit', async(e) => {

        e.preventDefault();

        const email = document.getElementById('email').value;
        const password = document.getElementById('password').value;

        try {

            const response = await fetch('/authentication/login', {

                method : 'POST',
                headers : {
                    'Content-Type' : 'application/json'
                },
                body : JSON.stringify({email, password})
                
            });

            if(response.ok) {

                window.location.href = '/dashboardView'

            } else {

                error.textContent = await response.text();

            }

        } catch (error) {
            
            error.textContent = await response.text();

        }
    });
</script>